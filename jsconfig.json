{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "strict": false
  },
  "include": [
    "lib/*.js",
    "tui/input.js",
    "tui/report.js",
    "tui/presentation.js",
    "scripts/*.js"
  ]
}
