{
  "name": "diagcalc",
  "version": "5.2.0",
  "description": "Diagnostic calculator for the browser, terminal, and plain CLI.",
  "homepage": "https://diagcalc.tiagojacinto.eu/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiagojct/diagcalc.git"
  },
  "bugs": {
    "url": "https://github.com/tiagojct/diagcalc/issues"
  },
  "license": "MIT",
  "keywords": [
    "diagnostics",
    "bayes",
    "clinical",
    "cli",
    "tui"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "lib",
    "tui",
    "web",
    "index.html",
    "script.js",
    "styles.css",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "diag": "bin/diagcalc.js",
    "diagcalc": "bin/diagcalc.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tui": "node bin/diagcalc.js --tui",
    "cli": "node bin/diagcalc.js --help",
    "test": "node --test test/*.test.js",
    "test:browser": "playwright test",
    "typecheck": "tsc --project jsconfig.json",
    "check": "npm run typecheck && npm test && npm run test:browser",
    "prepare:site": "node scripts/prepare-site.js",
    "pretest:browser": "npm run prepare:site"
  },
  "dependencies": {
    "blessed": "^0.1.81"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
